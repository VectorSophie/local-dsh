# Pinned external dependencies (nothing third-party is vendored in this repo).
# Changing a pin = a new release; install.sh keeps the previous build next to the new one (rollback).
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_COMMIT=7d7f0287530bc8981690f361d8c1627dbae1c99a   # tag b12211 (model README needs >= b11870)
DSH_PACKAGE=@deepseek-ai/dsh
DSH_VERSION=0.2.2-rc.1                                       # needs Node >= 24.9 (package engines)
DSH_TUI_PACKAGE=@deepseek-harness-tui/dsh-tui
DSH_TUI_VERSION=0.19.0                                       # third-party, MIT; optional plugin
PNPM_VERSION=12.18.0                                         # used only to install the optional TUI plugin
NODE_MIN=24.9.0
